# Premenné prostredia pre Alza AI Email Assistant

# --- Gemini: vyberte JEDEN spôsob ---
# A) Lokálne: API kľúč z https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# B) Cloud Run: Vertex AI cez service account (bez API kľúča)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# Tajný kľúč medzi n8n a Python API (POVINNÝ). Vygenerujte napr.: openssl rand -hex 32
N8N_API_KEY=
